<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/item_cart_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/rounder_background"
            android:backgroundTint="#F5F5F5"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            tools:srcCompat="@tools:sample/avatars" />

        <!-- Product Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/item_cart_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Sample Product Name"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/item_cart_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Regular Color"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/item_cart_subtotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LKR 1,000.00"
                    android:textColor="@color/md_theme_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Remove Button (Cleaned up) -->
                <ImageView
                    android:id="@+id/item_cart_remove"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:src="@drawable/delete_24px"
                    app:tint="#FF5252" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quantity Selector (Vertical) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounder_background"
            android:backgroundTint="#F8F8F8"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/item_cart_qty_plus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/rounder_background"
                android:backgroundTint="#FFFFFF"
                android:elevation="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/md_theme_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_cart_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="1"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/item_cart_qty_minus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/rounder_background"
                android:backgroundTint="#FFFFFF"
                android:elevation="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="-"
                android:textColor="@color/md_theme_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>