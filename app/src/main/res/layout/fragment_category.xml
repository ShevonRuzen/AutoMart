<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="5dp"
    tools:context=".fragment.CategoryFragment">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: Back Button and Search Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <ImageButton
                android:id="@+id/category_back_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/rounder_background"
                android:backgroundTint="#ffffff"
                android:elevation="2dp"
                android:padding="8dp"
                android:src="@drawable/arrow_back_24px" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/category_search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/search_bar_background"
                android:drawableStart="@drawable/search_24px"
                android:drawablePadding="10dp"
                android:hint="What do you want? "
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Category Horizontal List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/category_category_list_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="8dp" />

        <!-- Vertical Sections Scroll View -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/category_nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/category_section_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="80dp" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Search Results Overlay (Initially GONE) -->
    <!-- Positioned inside the root FrameLayout so it covers the NestedScrollView but stays below the header if needed -->
    <FrameLayout
        android:id="@+id/category_search_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:background="@color/md_theme_surface"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_results_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="8dp" />
    </FrameLayout>

    <!--    empty search result container-->
    <FrameLayout
        android:id="@+id/category_search_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:background="@color/md_theme_surface"
        android:visibility="gone"
        tools:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"

            android:orientation="vertical">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/search_24px"/>
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:text="No Search Results Found"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:textSize="20sp"/>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:text="Try different key word"
                android:textColor="@android:color/black"
                android:textSize="14sp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Cart FAB Container -->
    <FrameLayout
        android:id="@+id/category_add_to_cart_btn_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:visibility="gone">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/category_btn_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:backgroundTint="#000000"
            app:fabCustomSize="64dp"
            app:maxImageSize="32dp"
            app:rippleColor="#F5F5F5"
            app:tint="#FFFFFF"
            android:src="@drawable/shopping_basket_24px" />

        <TextView
            android:id="@+id/category_cart_item_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="15dp"
            android:background="@drawable/rounder_background"
            android:backgroundTint="#ff0000"
            android:elevation="8dp"
            android:gravity="center"
            android:padding="4dp"
            android:text="01"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!--    progress bar-->
    <FrameLayout
        android:id="@+id/category_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFFFFFF"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/category_progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Loading products..."
                android:textColor="@android:color/black"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>