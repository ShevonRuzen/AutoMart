            <!--                    android:padding="16dp">-->

            <!--                    <TextView-->
            <!--                        android:id="@+id/checkout_location_home_name"-->
            <!--                        android:layout_width="match_parent"-->
            <!--                        android:layout_height="wrap_content"-->
            <!--                        android:drawableEnd="@drawable/keyboard_arrow_down_24px"-->
